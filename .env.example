# --- Observabilidad ---
SERVICE_NAME=excel-reports-service
SERVICE_VERSION=1.0.0
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Identidad de quien consulta ---
IDENTITY_BACKEND=static        # static (demo) | google
STATIC_TOKENS=demo-token       # solo demo; nunca en producción
GOOGLE_AUDIENCE=               # obligatorio con IDENTITY_BACKEND=google

# --- Bases de datos de los clientes ---
CLIENT_DB_BACKEND=sqlite       # sqlite (demo) | master (MySQL, requirements-gcp.txt)
SQLITE_DIR=data/db
DEMO_CLIENTS=demo
MASTER_DB_URL=                 # mysql+pymysql://...; inyectar desde un gestor de secretos

# --- Reportes ---
REPORT_TIMEZONE=America/Bogota # zona en que se muestran las fechas
MAX_ROWS=500000                # máx. 1048575 (límite de una hoja de Excel)
MAX_RANGE_DAYS=366
FETCH_CHUNK_SIZE=5000
